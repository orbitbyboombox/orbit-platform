import test from "node:test"; import assert from "node:assert/strict"; import {overlap,reminderLabel,reminderProjection,alertPriority,agendaStatus} from "../features/operations-agenda-v11/domain.ts";
test("staff overlap and no overlap",()=>{assert.equal(overlap({start:"2026-01-01T10:00:00Z",end:"2026-01-01T12:00:00Z"},{start:"2026-01-01T11:00:00Z",end:"2026-01-01T13:00:00Z"}),"CONFLICTO");assert.equal(overlap({start:"2026-01-01T10:00:00Z",end:"2026-01-01T11:00:00Z"},{start:"2026-01-01T11:00:00Z",end:"2026-01-01T13:00:00Z"}),"SIN_CONFLICTO");assert.equal(overlap({start:null,end:null},{start:"2026-01-01T11:00:00Z",end:"2026-01-01T13:00:00Z"}),"NO_VERIFICABLE")});
test("reminder states and priorities",()=>{assert.equal(reminderLabel("SCHEDULED"),"PROGRAMADO");assert.equal(reminderLabel("SENT"),"COMPLETADO");assert.equal(reminderLabel("BLOCKED"),"BLOQUEADO");assert.equal(reminderLabel("FAILED"),"ERROR");assert.equal(alertPriority(24),"CRITICAL");assert.equal(alertPriority(60),"HIGH");assert.equal(alertPriority(100),"MEDIUM")});
test("reminder projection uses real history or no reminder",()=>{assert.equal(reminderProjection([]).status,"SIN REMINDER");assert.equal(reminderProjection([{status:"SENT",occurred_at:"2026-01-01T10:00:00Z"}]).status,"COMPLETADO");assert.equal(reminderProjection([{status:"FAILED",failure_reason:"bad a@b.cl"}]).error,"bad [redacted]")});
test("agenda status honors conflicts and checklist",()=>{assert.equal(agendaStatus({checklist:8,required:10,staff:"SIN_CONFLICTO",resources:"SIN_CONFLICTO",reminder:"PROGRAMADO"}),"ATENCIÓN");assert.equal(agendaStatus({checklist:10,required:10,staff:"CONFLICTO",resources:"SIN_CONFLICTO",reminder:"PROGRAMADO"}),"CRÍTICO");assert.equal(agendaStatus({checklist:10,required:10,staff:"SIN_CONFLICTO",resources:"SIN_CONFLICTO",reminder:"COMPLETADO"}),"LISTO")});
