import test from "node:test";import assert from "node:assert/strict";import{readFileSync}from"node:fs";import{assignmentNotificationFingerprint,buildStaffAssignmentEmail}from"../features/operations/staff-assignment-notification.model.ts";
const service=readFileSync("features/operations/staff-assignment-notification.service.ts","utf8"),actions=readFileSync("features/staff-assignment-center/actions.ts","utf8"),portal=readFileSync("features/portal-authentication/staff-portal.actions.ts","utf8"),ui=readFileSync("features/portal-authentication/staff-portal-dashboard.tsx","utf8"),operations=readFileSync("app/(platform)/operations/page.tsx","utf8");
test("assignment notification payload separates canonical call and service times",()=>{const email=buildStaffAssignmentEmail({staffName:"Juan Pérez",eventName:"Evento",orbitEventId:"ORB-1",role:"OPERATOR",staffCallAt:"2026-08-21T23:00:00-04:00",serviceStartAt:"2026-08-22T00:00:00-04:00",serviceEndAt:"2026-08-22T02:00:00-04:00",location:"Hilaria",portalUrl:"https://orbit.test/login?access=staff"});assert.match(email.textBody,/Citación Staff:/);assert.match(email.textBody,/Horario servicio:/);assert.match(email.textBody,/Portal Staff/)});
test("meaningful fingerprint is stable and changes with schedule",()=>{const base={assignmentId:"a",staffId:"s",role:"OPERATOR",staffCallAt:"2026-08-21T23:00:00-04:00",serviceStartAt:"2026-08-22T00:00:00-04:00",serviceEndAt:"2026-08-22T02:00:00-04:00",location:"H"};assert.equal(assignmentNotificationFingerprint(base),assignmentNotificationFingerprint({...base}));assert.notEqual(assignmentNotificationFingerprint(base),assignmentNotificationFingerprint({...base,staffCallAt:"2026-08-21T22:00:00-04:00"}))});
test("manual writer uses one backend notification boundary without failing assignment",()=>{assert.match(actions,/deliverStaffAssignmentNotification/);assert.match(actions,/catch\(notificationError\)/);assert.doesNotMatch(ui,/GoogleGmailApiProvider/)});
test("delivery tracks notification, queued/sent/failed and protects duplicates",()=>{for(const state of["NOTIFICATION_CREATED","EMAIL_SENT","EMAIL_FAILED","EMAIL_QUEUED"])assert.match(service,new RegExp(state));assert.match(service,/staff-assignment-delivery:/);assert.match(service,/prior==="EMAIL_SENT"/)});
test("inactive or missing-email Staff is never silently marked notified",()=>{assert.match(service,/staff\.status!=="ACTIVE"/);assert.match(service,/STAFF_EMAIL_MISSING/)});
test("Staff acceptance and rejection are scoped to own active assignment",()=>{assert.match(portal,/\.eq\("staff_id", session\.staff_id\)/);assert.match(portal,/rejectAssignedStaffAssignmentAction/);assert.match(portal,/\.eq\("staff_id",session\.staff_id\)/);assert.match(portal,/STAFF_REJECTED/)});
test("Founder surface exposes pending, rejected and email failed without parallel center",()=>{assert.match(operations,/Staff pendiente de confirmación/);assert.match(operations,/Falló notificación de Staff/);assert.match(operations,/STAFF_REJECTED/);assert.match(operations,/internal_notifications/)});
test("mobile portal keeps canonical fullscreen detail and touch-sized response actions",()=>{assert.match(ui,/CITACIÓN/);assert.match(ui,/SERVICIO/);assert.match(ui,/min-h-11[\s\S]*Aceptar asignación/);assert.match(ui,/Rechazar asignación/)});
test("official operations recipient is canonical and no finance writes exist",()=>{assert.match(service,/company_settings/);assert.match(service,/operations_email/);assert.doesNotMatch(service,/invoice_payments|receivable_movements|accounts_receivable|paid_amount/)});
test("tests inject payload logic and never send real email",()=>{assert.doesNotMatch(import.meta.url,/GoogleGmailApiProvider/);assert.match(service,/sender\?:Sender/)});
