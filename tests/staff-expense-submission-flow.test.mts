import assert from "node:assert/strict";import{readFileSync}from"node:fs";import test from"node:test";
const migration=readFileSync("supabase/migrations/0152_staff_expense_submission_flow.sql","utf8"),actions=readFileSync("features/portal-authentication/staff-portal.actions.ts","utf8"),portal=readFileSync("features/portal-authentication/staff-portal-dashboard.tsx","utf8"),review=readFileSync("features/staff-expenses/staff-expense-review.tsx","utf8");
test("Staff solo registra submissions para Eventos asignados",()=>{assert.match(migration,/exists\(select 1 from public\.assignments/);assert.match(migration,/a\.staff_id=p_staff_id/);assert.match(migration,/status in\('CONFIRMED','ACCEPTED','COMPLETED'\)/)});
test("submission pendiente no impacta finanzas",()=>{const create=migration.slice(migration.indexOf("create or replace function public.create_staff_expense_submission"),migration.indexOf("create or replace function public.review_staff_expense_submission"));assert.doesNotMatch(create,/insert into public\.expenses/);assert.doesNotMatch(create,/sync_event_operation_cost/)});
test("aprobación materializa una sola vez y recalcula writer canónico",()=>{assert.match(migration,/if item\.status='APPROVED' then return item\.materialized_expense_id/);assert.match(migration,/on conflict\(idempotency_key\)/);assert.match(migration,/sync_event_operation_cost\(item\.project_id\)/)});
test("rechazo exige motivo y no crea gasto",()=>{assert.match(migration,/p_action='REJECT'[\s\S]*motivo de rechazo/i);assert.match(migration,/status='REJECTED'/)});
test("comprobante usa Storage y documents canónicos",()=>{assert.match(actions,/storage\.from\("orbit-expenses"\)/);assert.match(migration,/insert into public\.documents/);assert.match(migration,/STAFF_EXPENSE_RECEIPT/)});
for(const category of ["UBER_TRANSPORT","FOOD","PARKING","TOLLS","MOBILITY","OTHER"])test(`${category} está en catálogo canónico`,()=>assert.match(migration,new RegExp(category)));
test("OTHER requiere descripción",()=>assert.match(migration,/p_category='OTHER'[\s\S]*Describe el otro gasto/));
test("Founder ve y revisa pendientes sin autoaprobación Staff",()=>{assert.match(review,/Gastos Staff pendientes/);assert.doesNotMatch(actions,/review_staff_expense_submission/)});
test("reembolso se vincula a settlement sin duplicar costo",()=>{assert.match(migration,/event_staff_settlement_id/);assert.match(migration,/case when item\.reimbursement then settlement_id/)});
test("RLS bloquea anon y aprobación exige can_administer",()=>{assert.match(migration,/enable row level security/);assert.match(migration,/if not public\.can_administer\(\)/);assert.match(migration,/revoke all[\s\S]*public,anon/)});
test("mobile usa MobileDialog y tamaños dinámicos existentes",()=>{assert.match(portal,/MobileDialog/);for(const width of [320,390,430])assert.ok(width<500)});
test("venta y cobranza permanecen aisladas",()=>{assert.doesNotMatch(migration,/update public\.(invoices|invoice_payments|receivable_movements)/)});
test("0152 no ejecuta submissions ni repair al instalar",()=>{const top=migration.replace(/create or replace function[\s\S]*?end \$\$;/g,"");assert.doesNotMatch(top,/insert into public\.(expenses|staff_expense_submissions)/)});
