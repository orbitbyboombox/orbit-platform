import assert from "node:assert/strict";
import test from "node:test";
import { actionUrgency, derivePipelineStage, followUpStatus, validateStageTransition } from "../features/sales-pipeline/domain.ts";
test("pipeline maps canonical commercial stages without duplicating Event truth", () => { assert.equal(derivePipelineStage({ commercialStage: "Quoting" }), "COTIZACIÓN"); assert.equal(derivePipelineStage({ commercialStage: "Waiting" }), "SEGUIMIENTO"); assert.equal(derivePipelineStage({ commercialStage: "Reserved", reservationStatus: "DRAFT" }), "RESERVA PENDIENTE"); assert.equal(derivePipelineStage({ commercialStage: "Confirmed", reservationStatus: "DRAFT" }), "RESERVA PENDIENTE"); assert.equal(derivePipelineStage({ commercialStage: "Confirmed", reservationStatus: "CONFIRMED" }), "GANADO"); });
test("GANADO requires canonical reservation and PERDIDO requires reason", () => { assert.match(validateStageTransition("COTIZACIÓN", "GANADO", { reservationConfirmed: false }) ?? "", /reserva canónica/); assert.match(validateStageTransition("SEGUIMIENTO", "PERDIDO", { reservationConfirmed: false }) ?? "", /motivo/); assert.equal(validateStageTransition("SEGUIMIENTO", "PERDIDO", { reservationConfirmed: false, lostReason: "Precio" }), null); });
test("next action urgency is explicit", () => { const now = new Date("2026-09-06T12:00:00Z"); assert.equal(actionUrgency(null, now), "SIN ACCIÓN"); assert.equal(actionUrgency("2026-09-06T15:00:00Z", now), "HOY"); assert.equal(actionUrgency("2026-09-05T15:00:00Z", now), "ATRASADO"); });
test("follow-up is blocked by handoff, opt-out, won/lost, or delivery flag", () => { const common = { nextActionAt: "2026-09-07T12:00:00Z", now: new Date("2026-09-06T12:00:00Z") }; assert.equal(followUpStatus({ ...common, stage: "SEGUIMIENTO", humanHandoff: true, optOut: false, deliveryEnabled: false }), "BLOCKED"); assert.equal(followUpStatus({ ...common, stage: "GANADO", humanHandoff: false, optOut: false, deliveryEnabled: false }), "BLOCKED"); assert.equal(followUpStatus({ ...common, stage: "SEGUIMIENTO", humanHandoff: false, optOut: false, deliveryEnabled: true }), "BLOCKED"); assert.equal(followUpStatus({ ...common, stage: "SEGUIMIENTO", humanHandoff: false, optOut: false, deliveryEnabled: false }), "SCHEDULED"); });
