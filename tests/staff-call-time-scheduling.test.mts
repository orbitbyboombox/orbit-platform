test("Portal Staff prioritizes call time over service schedule",()=>{assert.match(portal,/label="CITACIÓN"[\s\S]*label="SERVICIO"/);assert.ok(portal.indexOf('label="CITACIÓN"')<portal.indexOf('label="SERVICIO"'))});
test("Calendar starts at earliest absolute Staff call and ends at service end",()=>{const value=resolveEventOperationalWindow({assignmentStaffCalls:["2026-08-21T23:00:00-04:00","2026-08-21T22:00:00-04:00"],serviceStartAt:"2026-08-22T00:00:00-04:00",serviceEndAt:"2026-08-22T02:00:00-04:00"});assert.equal(value.operationalStartAt,"2026-08-21T22:00:00-04:00");assert.equal(value.serviceEndAt,"2026-08-22T02:00:00-04:00");assert.match(calendar,/calendarStartDate:calendarStart\.date,calendarStartTime:calendarStart\.time/);assert.match(calendar,/serviceEndDate:serviceEnd\.date/)});
test("Calendar falls back from assignment call to operational arrival and service start",()=>{assert.match(calendar,/resolveEventOperationalWindow/);const fallback=resolveEventOperationalWindow({assignmentStaffCalls:[],serviceStartAt:"2026-08-22T00:00:00-04:00",serviceEndAt:"2026-08-22T02:00:00-04:00"});assert.equal(fallback.source,"SERVICE_START")});
test("cross-midnight Calendar uses call date and absolute service end",()=>{assert.match(mapper,/date: input\.calendarStartDate/);assert.match(mapper,/startTime: input\.calendarStartTime/);assert.match(mapper,/endDate: input\.serviceEndDate/)});
test("Calendar description separates Staff call from service schedule",()=>{assert.match(mapper,/Citación Staff:/);assert.match(mapper,/Horario servicio:/)});
test("Google Calendar preserves Chile timezone and updates by existing ORBIT event id",()=>{assert.match(provider,/timeZone: "America\/Santiago"/);assert.match(calendar,/findByOrbitEventId/);assert.match(mapper,/provider\.updateEvent\(existing\.googleEventId/)});
test("Staff reminders calculate from absolute call time",()=>{assert.match(reminders,/row\.staff_call_at/);assert.match(reminders,/call\.getTime\(\)-Date\.now\(\)/)});
test("mobile fullscreen and financial isolation remain preserved",()=>{assert.match(dialog,/fullscreen-mobile/);assert.doesNotMatch(migration,/invoices|invoice_payments|receivable_movements|paid_amount/i)});
test("shared resolver uses earliest call and historical fallback",()=>{const call=resolveEventOperationalWindow({assignmentStaffCalls:["2026-08-21T23:00:00-04:00","2026-08-21T22:00:00-04:00"],staffArrivalAt:"2026-08-21T21:00:00-04:00",serviceStartAt:"2026-08-22T00:00:00-04:00",serviceEndAt:"2026-08-22T02:00:00-04:00"});assert.equal(call.operationalStartAt,"2026-08-21T22:00:00-04:00");assert.equal(call.source,"STAFF_CALL");assert.equal(resolveEventOperationalWindow({assignmentStaffCalls:[],staffArrivalAt:"2026-08-21T23:00:00-04:00",serviceStartAt:"2026-08-22T00:00:00-04:00",serviceEndAt:"2026-08-22T02:00:00-04:00"}).source,"STAFF_ARRIVAL")});
test("internal and Google Calendar reuse canonical operational window",()=>{assert.match(eventsRepository,/resolveEventOperationalWindow/);assert.match(calendar,/resolveEventOperationalWindow/)});
test("0156 preview is read only and execute queues only active linked events",()=>{assert.match(resync,/preview_calendar_operational_resync/);assert.match(resync,/status='UPDATE_REQUIRED'/);assert.match(resync,/status not in\('CANCELLED','CANCELED','ARCHIVED','DELETED'\)/)});
test("0156 does not autoexecute and retry queue is idempotent",()=>{assert.doesNotMatch(resync,/select public\.execute_calendar_operational_resync|call public\.execute_calendar_operational_resync/i);assert.match(resync,/cs\.status is distinct from 'UPDATE_REQUIRED'/)});
test("0156 blocks contradictory schedules from global execute",()=>{assert.match(resync,/REQUIRES_FOUNDER_REVIEW/);assert.match(resync,/requires_founder_review boolean/);assert.match(resync,/not p\.requires_founder_review/)});
test("0156 preserves fractional service hours with numeric interval arithmetic",()=>{assert.match(resync,/greatest\(1::numeric,[\s\S]*\)\*interval '1 hour'/);assert.doesNotMatch(resync,/make_interval\(hours=>/);assert.doesNotMatch(resync,/duration_hours\)::int|duration_hours::int/)});
