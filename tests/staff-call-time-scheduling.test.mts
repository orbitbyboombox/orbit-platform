import assert from"node:assert/strict";import{readFileSync}from"node:fs";import test from"node:test";
import{normalizeEventSchedule}from"../features/operations/event-scheduling.ts";
const root=new URL("../",import.meta.url),read=(path:string)=>readFileSync(new URL(path,root),"utf8");
const migration=read("supabase/migrations/0155_staff_call_time_scheduling.sql"),calendar=read("features/connectors/google-calendar/application/google-calendar-sync.service.ts"),mapper=read("features/connectors/google-calendar/application/google-calendar-live.ts"),provider=read("features/connectors/google-calendar/provider/google-calendar-live.provider.ts"),reminders=read("app/api/cron/staff-assignment-reminders/route.ts"),portal=read("features/portal-authentication/staff-portal-dashboard.tsx"),eventUi=read("features/crm/event-center.tsx"),assignment=read("features/staff-assignment-center/actions.ts"),dialog=read("components/ui/mobile-dialog.tsx");
test("service 00:00 to 02:00 remains same operational day",()=>{const value=normalizeEventSchedule("2026-08-22T00:00","2026-08-22T02:00","2026-08-21T23:00");assert.equal(value.serviceEndAt,"2026-08-22T02:00");assert.equal(value.staffCallAt,"2026-08-21T23:00")});
test("service 23:00 to 02:00 resolves end on following day",()=>assert.equal(normalizeEventSchedule("2026-08-22T23:00","2026-08-22T02:00").serviceEndAt,"2026-08-23T02:00"));
test("0155 uses absolute Chile timestamps and performs no historical backfill",()=>{assert.match(migration,/staff_call_at timestamptz/);assert.match(migration,/at time zone'America\/Santiago'/);assert.doesNotMatch(migration,/update public\.assignments set staff_call_at[\s\S]*where staff_call_at is null/i)});
test("manual assignment call time is independent and explicit",()=>{assert.match(assignment,/staff_call_at:value\(input\.staffCallAt\?\?""\)/);assert.match(assignment,/MANUAL_OVERRIDE/);assert.match(migration,/coalesce\(staff_call_source,'DERIVED'\)='DERIVED'/)});
test("Event editor separates service end and Staff call datetime",()=>{assert.match(eventUi,/name="serviceEndAt"[\s\S]*type="datetime-local"/);assert.match(eventUi,/name="staffCallAt"[\s\S]*type="datetime-local"/)});
test("Portal Staff prioritizes call time over service schedule",()=>{assert.match(portal,/label="CITACIÓN"[\s\S]*label="SERVICIO"/);assert.ok(portal.indexOf('label="CITACIÓN"')<portal.indexOf('label="SERVICIO"'))});
test("Calendar starts at earliest absolute Staff call and ends at service end",()=>{assert.match(calendar,/assignmentCalls[\s\S]*sort\(\(left,right\)=>new Date\(left\)\.getTime\(\)-new Date\(right\)\.getTime\(\)\)/);assert.match(calendar,/calendarStartDate:calendarStart\.date,calendarStartTime:calendarStart\.time/);assert.match(calendar,/serviceEndDate:serviceEnd\.date/)});
test("Calendar falls back from assignment call to operational arrival and service start",()=>assert.match(calendar,/assignmentCalls\[0\]\?\?operational\?\.staff_arrival_at\?\?null[\s\S]*earliestCall\?chileDateTime\(earliestCall\):serviceStart/));
test("cross-midnight Calendar uses call date and absolute service end",()=>{assert.match(mapper,/date: input\.calendarStartDate/);assert.match(mapper,/startTime: input\.calendarStartTime/);assert.match(mapper,/endDate: input\.serviceEndDate/)});
test("Calendar description separates Staff call from service schedule",()=>{assert.match(mapper,/Citación Staff:/);assert.match(mapper,/Horario servicio:/)});
test("Google Calendar preserves Chile timezone and updates by existing ORBIT event id",()=>{assert.match(provider,/timeZone: "America\/Santiago"/);assert.match(calendar,/findByOrbitEventId/);assert.match(mapper,/provider\.updateEvent\(existing\.googleEventId/)});
test("Staff reminders calculate from absolute call time",()=>{assert.match(reminders,/row\.staff_call_at/);assert.match(reminders,/call\.getTime\(\)-Date\.now\(\)/)});
test("mobile fullscreen and financial isolation remain preserved",()=>{assert.match(dialog,/fullscreen-mobile/);assert.doesNotMatch(migration,/invoices|invoice_payments|receivable_movements|paid_amount/i)});
