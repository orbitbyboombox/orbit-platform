import assert from "node:assert/strict";import{readFileSync}from"node:fs";import test from"node:test";import{isValidChileanRut,normalizeChileanRut,requireValidChileanRut}from"../lib/chile/rut.ts";
const migration=readFileSync("supabase/migrations/0153_staff_portal_authentication_fix.sql","utf8"),actions=readFileSync("features/portal-authentication/actions.ts","utf8"),form=readFileSync("features/portal-authentication/portal-login-form.tsx","utf8"),pinUi=readFileSync("features/portal-authentication/staff-pin-reset.tsx","utf8"),setup=readFileSync("supabase/migrations/0091_rc30b1_staff_portal_activation.sql","utf8"),password=readFileSync("supabase/migrations/0090_rc30b_staff_request_workflow.sql","utf8");
for(const rut of ["16.357.402-0","16357402-0","163574020"])test(`RUT equivalente ${rut}`,()=>assert.equal(requireValidChileanRut(rut),"163574020"));
test("DV inválido se rechaza",()=>{assert.equal(isValidChileanRut("16.357.402-1"),false);assert.throws(()=>requireValidChileanRut("163574021"))});test("normalización no guarda variantes",()=>assert.equal(normalizeChileanRut("16.357.402-0"),"163574020"));
test("PIN y contraseña usan bcrypt compatible sin plaintext",()=>{for(const sql of [setup,password]){assert.match(sql,/crypt\(/);assert.match(sql,/gen_salt\('bf'/);assert.doesNotMatch(sql,/pin_hash\s*=\s*p_(pin|password)(?:\W|$)/)}});
for(const code of ["USER_NOT_FOUND","STAFF_INACTIVE","PORTAL_DISABLED","PIN_NOT_CONFIGURED","HASH_FORMAT_ERROR","PIN_INVALID","LOCKED"])test(`audita ${code}`,()=>assert.match(migration,new RegExp(code)));
test("bloqueo no se autoextiende",()=>{assert.match(migration,/coalesce\(failure_code,''\)<>'LOCKED'/);assert.match(migration,/interval '15 minutes'/)});test("PIN correcto crea solo sesión STAFF",()=>{assert.match(migration,/portal_access_sessions\(access_type,staff_id/);assert.match(migration,/values\('STAFF',member\.id/);assert.doesNotMatch(migration,/customer_id/)});test("Founder con identidad Staff no hereda Admin",()=>assert.doesNotMatch(migration,/profiles|can_administer/));
test("mensaje público no filtra existencia y código interno sí queda trazable",()=>{assert.match(actions,/No fue posible validar la información ingresada/);assert.match(actions,/STAFF_PORTAL_AUTH_REJECTED/)});test("login mobile y desktop comparten formulario seguro",()=>{assert.match(form,/min-h-12/);assert.match(form,/current-password/);assert.match(form,/staffPortalLoginAction/)});test("UI distingue generar de activar PIN",()=>{assert.match(pinUi,/Activa el PIN para guardarlo/);assert.match(pinUi,/Crear PIN temporal nuevo/)});test("0153 no cambia credenciales ni repara datos al instalar",()=>{const top=migration.replace(/create or replace function[\s\S]*?end \$\$;/g,"");assert.doesNotMatch(top,/update public\.staff|delete from public\.portal_access_attempts/)});
