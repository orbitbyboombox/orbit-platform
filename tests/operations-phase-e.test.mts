import assert from "node:assert/strict";
import {readFileSync} from "node:fs";
import test from "node:test";
const root=process.cwd(),migration=readFileSync(`${root}/supabase/migrations/0134_operations_phase_e_logistics.sql`,"utf8"),completion=readFileSync(`${root}/supabase/migrations/0135_operations_phase_e_completion.sql`,"utf8"),actions=readFileSync(`${root}/features/operations/event-logistics.actions.ts`,"utf8"),ui=readFileSync(`${root}/features/operations/event-logistics-center.tsx`,"utf8"),staff=readFileSync(`${root}/features/portal-authentication/staff-portal.tsx`,"utf8"),portal=readFileSync(`${root}/features/projects/components/customer-portal-experience.tsx`,"utf8"),routes=readFileSync(`${root}/supabase/migrations/0030_route_cost_engine.sql`,"utf8");
const certification=readFileSync(`${root}/supabase/migrations/0136_operations_phase_e_certification_fixes.sql`,"utf8"),staffActions=readFileSync(`${root}/features/portal-authentication/staff-portal.actions.ts`,"utf8"),staffUi=readFileSync(`${root}/features/portal-authentication/staff-portal-dashboard.tsx`,"utf8"),cron=readFileSync(`${root}/app/api/cron/staff-assignment-reminders/route.ts`,"utf8");
test("Phase E extends canonical fleet instead of creating a parallel vehicle model",()=>{assert.match(migration,/references public\.operational_assets/);assert.doesNotMatch(migration,/create table.*logistics_vehicles/i)});
test("vehicle availability uses an exclusion constraint for concurrent windows",()=>{assert.match(migration,/exclude using gist/);assert.match(migration,/tstzrange\(planned_start_at,planned_end_at,'\[\)'\) with &&/)});
test("conflicts return a useful Founder message",()=>assert.match(migration,/VEHÍCULO NO DISPONIBLE.*Asignado a otro Evento entre/));
test("driver ownership remains independent from Staff operational roles",()=>{assert.match(migration,/driver_staff_id/);assert.match(migration,/driver_profile_id/);assert.match(migration,/driver_name/);assert.doesNotMatch(migration,/assignment_type='DRIVER'/)});
test("canonical trip types cover delivery pickup operation and return",()=>{for(const type of["DELIVERY_ASSEMBLY","PICKUP_DISASSEMBLY","EVENT_OPERATION","RETURN"])assert.match(migration,new RegExp(type))});
test("an Event supports multiple trips and vehicles",()=>{assert.doesNotMatch(migration,/unique\s*\(project_id\)/);assert.match(migration,/sequence integer/)});
test("shared route proration remains equal and preserves final rounding",()=>{assert.match(routes,/round\(total\/event_count,2\)/);assert.match(routes,/total-\(round\(total\/event_count,2\)\*\(event_count-1\)\)/)});
test("route order is Founder-controlled and never auto-optimized",()=>{assert.match(migration,/sequence integer/);assert.doesNotMatch(migration,/optimi[sz]|shortest_path/i)});
test("odometer and distance preserve manual operational evidence",()=>{assert.match(migration,/odometer_start/);assert.match(migration,/odometer_end/);assert.match(migration,/distance=/)});
test("fuel toll parking and other logistics costs use canonical expenses",()=>{for(const category of["FUEL","TOLLS","PARKING","TRANSPORT","OTHER_OPERATIONAL"])assert.match(actions,new RegExp(category));assert.match(actions,/from\("expenses"\)\.insert/)});
test("external transport does not require a permanent vehicle",()=>{assert.match(migration,/logistics_mode.*EXTERNAL/);assert.match(ui,/Sin vehículo BOOMBOX/)});
test("Staff own transport is explicit and separate",()=>assert.match(migration,/STAFF_OWN/));
test("real logistics cost keeps fuel allocations and expenses traceable",()=>{assert.match(migration,/event_logistics_summary/);assert.match(migration,/allocated_fuel_cost/);assert.match(migration,/real_logistics_cost/)});
test("trip execution records start arrival completion timestamps",()=>{for(const field of["started_at","arrived_at","completed_at"])assert.match(migration,new RegExp(field))});
test("mobile receipts accept camera photos and PDF",()=>{assert.match(ui,/capture="environment"/);assert.match(actions,/image\/jpeg/);assert.match(actions,/application\/pdf/)});
test("logistics expenses start pending and never auto-close accounting",()=>assert.match(actions,/status:"PENDING"/));
test("readiness does not invent obligations for Events without logistics",()=>assert.match(migration,/when c\.logistics_mode='NOT_REQUIRED' then '\[\]'::jsonb/));
test("maintenance and unavailable vehicles cannot be assigned",()=>{assert.match(migration,/operational_status='OPERATIONAL'/);assert.match(migration,/a\.status='AVAILABLE'/)});
test("Staff projection exposes vehicle operations but not internal logistics cost",()=>{assert.match(staff,/event_vehicle_assignments/);assert.doesNotMatch(staff,/real_logistics_cost|allocated_fuel_cost|toll_cost|parking_cost/)});
test("Client Portal remains isolated from internal logistics",()=>assert.doesNotMatch(portal,/vehicle_trips|event_logistics_summary|allocated_fuel_cost/));
test("audit trail covers trip and expense mutations",()=>{assert.match(migration,/vehicle_trips_audit/);assert.match(migration,/audit_row_change/)});
test("financial recalculation remains canonical",()=>{assert.match(actions,/calculateAndPersistRealEventCost/);assert.doesNotMatch(actions,/profit\s*=|margin\s*=/)});
test("logistics closure requires resolved work or explicit Founder reason",()=>{assert.match(completion,/close_event_logistics/);assert.match(completion,/Cierre pendiente/);assert.match(ui,/Cerrar con pendientes|Razón de override/)});
test("event cancellation releases future logistics without deleting history",()=>{assert.match(completion,/event_logistics_project_changed/);assert.match(completion,/status='CANCELLED'/);assert.doesNotMatch(completion,/delete from public\.vehicle_trips/)});
test("date time and address changes invalidate planned logistics",()=>{assert.match(completion,/old\.event_date,old\.event_time,old\.location,old\.city/);assert.match(completion,/logistics_status='PENDING'/)});
test("access height and vehicle dimensions produce a non-blocking warning",()=>{assert.match(completion,/max_access_height/);assert.match(completion,/height_m/);assert.match(ui,/supera la altura conocida/)});
test("expense review and duplicate protection are canonical",()=>{assert.match(completion,/review_event_logistics_expense/);assert.match(completion,/expenses_idempotency_key_unique/);assert.match(actions,/idempotencyKey/)});
test("confirmed Staff can execute only their canonical assigned trips",()=>{assert.match(certification,/update_staff_vehicle_trip_status/);assert.match(certification,/driver_staff_id=p_staff_id/);assert.match(certification,/No existe una asignación operacional confirmada/);assert.match(staffActions,/update_staff_vehicle_trip_status/);assert.match(staffUi,/Mis viajes logísticos/)});
test("logistics Timeline is delivered after canonical writes using allowed sources",()=>{assert.match(actions,/LOGISTICS_TIMELINE_BOUNDARY/);assert.match(actions,/source:\"Operations\"/);assert.match(staffActions,/source:\"Staff\"/)});
test("upcoming logistics alerts are idempotent and run from the existing cron",()=>{assert.match(certification,/refresh_logistics_notifications/);assert.match(certification,/on conflict\(correlation_id\) do nothing/);assert.match(cron,/refresh_logistics_notifications/)});
test("vehicle maintenance invalidates future logistics readiness",()=>{assert.match(certification,/vehicle_health_logistics_alert/);assert.match(certification,/LOGISTICS_VEHICLE_UNAVAILABLE/);assert.match(certification,/logistics_status='PENDING'/)});
test("cancelled trips preserve audit history and rejected expenses do not count as real cost",()=>{assert.match(certification,/set status='CANCELLED'/);assert.doesNotMatch(certification,/set status='CANCELLED',deleted_at/);assert.match(certification,/status not in\('CANCELLED','REJECTED'\)/)});
