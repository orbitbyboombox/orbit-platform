import assert from "node:assert/strict";
import test from "node:test";
import { readFile } from "node:fs/promises";
import { assertCorporateCreditTerms, corporateCreditDueDate, normalizeCorporateCreditDays } from "../features/accounts-receivable/corporate-credit-terms.ts";
import { resolveQuoteConversionPaymentTerms } from "../features/commercial-hub/quote-conversion.ts";

const read = (path: string) => readFile(new URL(path, import.meta.url), "utf8");
const review = (days: number) => ({ financial: { paymentCondition: "CORPORATE_CREDIT", paymentTermDays: days } }) as Parameters<typeof resolveQuoteConversionPaymentTerms>[0];

test("manual Empresa reservation accepts a positive approved credit term", () => assert.equal(assertCorporateCreditTerms({ paymentCondition: "CORPORATE_CREDIT", paymentTermDays: 30, approved: true }), 30));
for (const days of [15, 30, 45, 60, 90]) test(`${days}-day corporate credit remains canonical`, () => { assert.equal(normalizeCorporateCreditDays(days), days); assert.equal(resolveQuoteConversionPaymentTerms(review(days), {}).paymentTermDays, days); });
test("custom valid credit days remain supported", () => assert.equal(assertCorporateCreditTerms({ paymentCondition: "CORPORATE_CREDIT", paymentTermDays: 37, approved: true }), 37));
test("manual and quote conversion use the same issue-date due-date rule", () => { const issue = new Date("2026-08-27T12:00:00-04:00"); const due = corporateCreditDueDate(issue, resolveQuoteConversionPaymentTerms(review(30), {}).paymentTermDays); assert.equal(new Intl.DateTimeFormat("en-CA", { timeZone: "America/Santiago" }).format(due), "2026-09-26"); });
test("missing terms and missing approval fail before reservation mutation", async () => { assert.throws(() => assertCorporateCreditTerms({ paymentCondition: "CORPORATE_CREDIT", paymentTermDays: 0, approved: true }), /mayor a 0 días/); assert.throws(() => assertCorporateCreditTerms({ paymentCondition: "CORPORATE_CREDIT", paymentTermDays: 30, approved: false }), /aprobar el crédito/); const action = await read("../features/projects/actions/customer.actions.ts"); assert.ok(action.indexOf("assertCorporateCreditTerms") < action.indexOf("createWithProject(draft)")); });
test("wizard blocks zero-day corporate credit and explains validation", async () => { const wizard = await read("../features/projects/components/new-project-drawer.tsx"); assert.match(wizard, /paymentTermDays > 0 && corporateCreditApproved/); assert.match(wizard, /Selecciona un plazo de crédito mayor a 0 días antes de confirmar/); assert.doesNotMatch(wizard, /\["CASH", "Al día"\]/); });
test("manual draft recovery persists credit term, custom days, approval and receipt policy", async () => { const wizard = await read("../features/projects/components/new-project-drawer.tsx"); for (const field of ["creditTerm", "customCreditDays", "paymentReceiptRequired", "corporateCreditApproved"]) assert.ok(wizard.match(new RegExp(field, "g"))!.length >= 3, field); });
test("canonical receivable is created once through the shared sync function", async () => { const [action, migration] = await Promise.all([read("../features/projects/actions/customer.actions.ts"), read("../supabase/migrations/0176_empresa_credit_receivable_integrity.sql")]); assert.match(action, /sync_project_receivable_terms/); assert.match(migration, /invoices_one_active_receivable_per_project_uq/); assert.doesNotMatch(action, /invoiceNumber = `FAC-/); });
test("a 458150 corporate balance is preserved as the final canonical total", () => { const amount = 385000 + Math.round(385000 * 0.19); assert.equal(amount, 458150); assert.equal(amount - 0, 458150); });
test("Accounts Receivable visibility uses the production projection", async () => { const migration = await read("../supabase/migrations/0176_empresa_credit_receivable_integrity.sql"); assert.match(migration, /join public\.accounts_receivable_projection i/); assert.match(migration, /true in_accounts_receivable/); });
test("Empresa Credit visibility derives from the same projection", async () => assert.match(await read("../supabase/migrations/0176_empresa_credit_receivable_integrity.sql"), /true in_company_credit/));
test("Cobrar Clientes visibility derives from the same projection", async () => assert.match(await read("../supabase/migrations/0176_empresa_credit_receivable_integrity.sql"), /true in_collection_center/));
test("retry updates the existing manual DRAFT quotation instead of creating a parallel quote", async () => { const action = await read("../features/projects/actions/customer.actions.ts"); assert.match(action, /else if \(!draft\.commercialSourceQuotationId\)[\s\S]*\.eq\("status", "DRAFT"\)/); assert.match(action, /pricing_snapshot: pricingSnapshot/); });
test("double-click and network retry keep timeline and negotiation audit idempotent", async () => { const action = await read("../features/projects/actions/customer.actions.ts"); assert.match(action, /timelineCount[\s\S]*correlation_id: transactionId/); assert.match(action, /negotiationCount[\s\S]*reservation_commercial_negotiations/); });
test("partial AR commit reports recoverable state", async () => { const action = await read("../features/projects/actions/customer.actions.ts"); assert.match(action, /Reserva creada\. Cuenta por cobrar pendiente de sincronización/); assert.match(action, /createWithProject\(draft\)/); });
test("Payment Ledger remains untouched by receivable synchronization", async () => { const migration = await read("../supabase/migrations/0176_empresa_credit_receivable_integrity.sql"); assert.doesNotMatch(migration, /(?:insert|update|delete)\s+(?:into\s+)?public\.(?:payment_ledger|invoice_payments)/i); });
test("quote-to-reservation keeps corporate credit validation parity", () => { assert.throws(() => resolveQuoteConversionPaymentTerms(review(0), {}), /mayor a 0 días/); assert.equal(resolveQuoteConversionPaymentTerms(review(45), {}).paymentTermDays, 45); });
test("mobile wizard retains one scroll region and safe action area", async () => { const wizard = await read("../features/projects/components/new-project-drawer.tsx"); assert.match(wizard, /data-reservation-wizard-scroll/); assert.match(wizard, /min-h-0 flex-1 overflow-y-auto overscroll-contain/); assert.match(wizard, /data-reservation-wizard-actions/); assert.match(wizard, /safe-area-inset-bottom/); });
test("desktop summary does not overlay forms", async () => { const wizard = await read("../features/projects/components/new-project-drawer.tsx"); assert.match(wizard, /h-fit lg:sticky lg:top-0/); assert.doesNotMatch(wizard, /max-lg:sticky max-lg:bottom-0/); });
test("optional receipt does not block an approved corporate reservation", async () => { const wizard = await read("../features/projects/components/new-project-drawer.tsx"); assert.match(wizard, /!paymentReceiptRequired \|\|[\s\S]*Boolean\(receipt\)/); assert.match(wizard, /required=\{paymentReceiptRequired\}/); });
test("partial retry may refresh only the fingerprint of the same committed Event", async () => { const migration = await read("../supabase/migrations/0179_manual_reservation_partial_retry_fingerprint.sql"); for (const checkpoint of ["Customer Lookup", "Customer Create / Reuse", "Project Create", "Event Create", "Timeline"]) assert.match(migration, new RegExp(`completed_steps[\\s\\S]*${checkpoint.replaceAll("/", "\\/")}`)); for (const identity of ["requested_customer_id is distinct from tx.customer_id", "stored_project.project_type", "stored_project.event_date", "stored_project.event_time", "stored_project.location", "stored_project.city"]) assert.match(migration, new RegExp(identity.replaceAll(".", "\\."))); assert.match(migration, /set draft_fingerprint=fingerprint/); });
test("fingerprint recovery migration creates no Customer Event receivable or payment data", async () => { const migration = await read("../supabase/migrations/0179_manual_reservation_partial_retry_fingerprint.sql"); const installation = migration.replace(/\$\$[\s\S]*?\$\$/g, "FUNCTION_BODY"); assert.doesNotMatch(installation, /(?:insert|update|delete)\s+(?:into\s+)?public\.(?:customers|projects|invoices|invoice_payments)/i); assert.doesNotMatch(migration, /delete\s+from/i); });
