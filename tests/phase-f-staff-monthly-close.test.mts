import assert from"node:assert/strict";import{readFileSync}from"node:fs";import test from"node:test";
const migration=readFileSync("supabase/migrations/0159_event_and_staff_close_cycle.sql","utf8"),eventUi=readFileSync("features/event-operations-checklist/event-close-cycle-panel.tsx","utf8"),staffUi=readFileSync("features/staff-payments/staff-payments-center.tsx","utf8");
test("event close gate covers operation assets incidents Staff expenses and finance",()=>{for(const code of["SERVICE_NOT_FINISHED","ASSET_RETURN_PENDING","ASSET_REVIEW_REQUIRED","INCIDENTS_OPEN","STAFF_NOT_FINALIZED","SETTLEMENT_MISSING","STAFF_EXPENSE_PENDING","EXPENSE_PENDING","FINANCIAL_INVARIANT"])assert.match(migration,new RegExp(code))});
test("event cannot close with pending equipment high incident or Staff expense",()=>{assert.match(migration,/returned_assets<assigned_assets/);assert.match(migration,/event_incidents where project_id=p_project_id and status='OPEN'/);assert.match(migration,/staff_expense_submissions where project_id=p_project_id and status='PENDING_REVIEW'/)});
test("close synchronizes the sole canonical profitability writer",()=>{assert.match(migration,/perform public\.sync_event_operation_cost\(p_project_id\)/);assert.match(migration,/real_cost=total_operational_cost/);assert.doesNotMatch(migration,/update public\.invoices|insert into public\.invoice_payments|update public\.accounts_receivable/)});
test("closed cost cannot change silently and reopen requires a reason",()=>{assert.match(migration,/financial_event_closed_cost_guard/);assert.match(migration,/Evento cerrado: reabre/);assert.match(migration,/Motivo de reapertura obligatorio/);assert.match(migration,/reopen_reason/)});
test("asset return is idempotent and damaged or missing creates an incident",()=>{assert.match(migration,/record_event_asset_return/);assert.match(migration,/return_condition in\('OK','DAMAGED','MISSING','REQUIRES_REVIEW'\)/);assert.match(migration,/on conflict\(asset_assignment_id,incident_type\) do update/);assert.match(migration,/p_condition in\('DAMAGED','MISSING'\)/)});
test("monthly eligibility requires closed Event or audited Founder override",()=>{assert.match(migration,/c\.status='CLOSED' or o\.settlement_id is not null/);assert.match(migration,/override_staff_monthly_close_eligibility/);assert.match(migration,/reason text not null/)});
test("monthly close freezes a versioned settlement universe",()=>{assert.match(migration,/staff_monthly_close_items/);assert.match(migration,/close_version/);assert.match(migration,/settlement_snapshot/);assert.match(migration,/unique\(monthly_close_id,close_version,settlement_id\)/)});
test("later settlement does not enter a closed snapshot silently",()=>{const close=migration.match(/create or replace function public\.close_staff_month[\s\S]*?end \$\$;/)?.[0]??"",triggers=[...migration.matchAll(/create trigger[^;]+;/gi)].map(match=>match[0]);assert.match(close,/insert into public\.staff_monthly_close_items/);assert.equal(triggers.some(trigger=>/staff_monthly_close_items/i.test(trigger)),false)});
test("month reopen is audited and PAID is guarded",()=>{assert.match(migration,/reopen_staff_month/);assert.match(migration,/Un mes pagado requiere conciliación extraordinaria/);assert.match(migration,/reopened_at/)});
test("advances reimbursements receipts and payment remain existing settlement truth",()=>{for(const field of["adjustment_total","reimbursement_total","paid_amount","remaining_balance","sii_receipt_status"])assert.match(migration,new RegExp(field));assert.match(migration,/refresh_staff_month_payment_state/)});
test("due date is calendar day 25 and closed is not paid",()=>{assert.match(migration,/due_date=\(accounting_month\+interval '24 days'\)::date/);assert.match(migration,/status='CLOSED'/);assert.match(migration,/status='PAID'/)});
test("Founder Event and monthly Staff surfaces expose close and reopen",()=>{assert.match(eventUi,/Cierre del Evento/);assert.match(eventUi,/Cerrar Evento/);assert.match(eventUi,/Reabrir Evento/);assert.match(staffUi,/Cierre mensual Staff/);assert.match(staffUi,/Cerrar mes/);assert.match(staffUi,/Reabrir/)});
test("critical operations are RBAC protected",()=>{assert.match(migration,/auth\.uid\(\) is null or not public\.can_administer\(\)/);assert.match(migration,/enable row level security/);assert.match(migration,/revoke all .* from public,anon/)});
test("0159 installation has no close backfill payment or repair side effect",()=>{const top=migration.replace(/\$\$[\s\S]*?\$\$/g,"FUNCTION_BODY");assert.doesNotMatch(top,/\b(update|insert into|delete from)\s+public\.(projects|event_staff_payments|expenses|financial_event_records|invoice_payments|invoices)/i);assert.doesNotMatch(migration,/select public\.close_event_operation|select public\.close_staff_month|perform public\.close_staff_month/)});
