{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feat/bianca-v3-canonical-bridge": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/staff-assignment-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/google-calendar-resync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/office-lease-monthly",
      "schedule": "5 5 1 * *"
    },
    {
      "path": "/api/cron/event-deletion-cleanup",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/mercadopago-health",
      "schedule": "*/5 * * * *"
    }
  ]
}
