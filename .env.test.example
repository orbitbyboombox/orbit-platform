# BIANCA TEST/STAGING ONLY. Replace the placeholder with an independently
# provisioned Supabase project. Never copy production credentials here.
ORBIT_ENVIRONMENT=test
SUPABASE_URL=https://<test-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External side effects must remain disabled during certification.
WHATSAPP_DELIVERY_ENABLED=false
WHATSAPP_AUTOMATION_ENABLED=false
WHATSAPP_COMMERCIAL_ACTIONS_ENABLED=false
BIANCA_CUSTOMER_MESSAGING_ENABLED=false
BIANCA_AI_ENABLED=false
BIANCA_OUTBOUND_ENABLED=false
BIANCA_FOUNDER_NOTIFICATIONS_ENABLED=false
BIANCA_SHADOW_MODE=false
BIANCA_GLOBAL_KILL_SWITCH=true
